# Copia este archivo como .env y coloca tus propios valores (no subas .env a GitHub)
PORT=3000

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=catalogo_db

# JWT (lo usa el módulo de autenticación)
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Administrador inicial (lo usa scripts/crear-admin.js)
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@ejemplo.com
ADMIN_PASSWORD=
